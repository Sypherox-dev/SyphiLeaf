Subject: [PATCH] Disable shieldbreak sound


diff --git a/net/minecraft/world/item/component/BlocksAttacks.java b/net/minecraft/world/item/component/BlocksAttacks.java
index 454b97fdf142e1bc1c887627a6eeeba54e67bb7e..9999999999999999999999999999999999999999 100644
