@@ -94,17 +94,5 @@ public record BlocksAttacks(
             }
 
             entity.stopUsingItem();
-            this.disableSound
-                .ifPresent(
-                    sound -> level.playSound(
-                        null,
-                        entity.getX(),
-                        entity.getY(),
-                        entity.getZ(),
-                        (Holder<SoundEvent>)sound,
-                        entity.getSoundSource(),
-                        0.8F,
-                        0.8F + level.random.nextFloat() * 0.4F
